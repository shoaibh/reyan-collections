# Postgres connection string
DATABASE_URI=postgres://user@localhost:5432/reyan_dev
# Payload secret (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public base URL of the site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Shared secret the Cloudflare origin lock checks (min 32 chars, generate with: openssl rand -hex 32)
ORIGIN_SECRET=YOUR_ORIGIN_SECRET_HERE
# Email of the admin user created by the seed script
SEED_ADMIN_EMAIL=admin@reyancollection.in
# Password of the admin user created by the seed script
SEED_ADMIN_PASSWORD=CHANGE_ME
# Media storage backend: local | r2 (required in production: r2 there)
MEDIA_STORAGE=local
# Cloudflare R2 bucket name (when MEDIA_STORAGE=r2)
R2_BUCKET=
# Cloudflare R2 S3 endpoint URL
R2_ENDPOINT=
# R2 access key id
R2_ACCESS_KEY_ID=
# R2 secret access key
R2_SECRET_ACCESS_KEY=
# Public URL serving R2 media
R2_PUBLIC_URL=
# Node flags used by the Payload CLI
NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"
# Shiprocket integration: mock | live
# Required in production: live or mock (unset fails closed)
SHIPROCKET_MODE=mock
# Shiprocket API user email (live mode)
SHIPROCKET_EMAIL=
# Shiprocket API user password (live mode)
SHIPROCKET_PASSWORD=
# Shared token Shiprocket sends on courier webhooks (live mode)
SHIPROCKET_WEBHOOK_TOKEN=

# Razorpay integration: mock | live (anything else means mock)
# Required in production: live or mock (unset fails closed)
RAZORPAY_MODE=mock
# Razorpay key id (live mode)
RAZORPAY_KEY_ID=
# Razorpay key secret (live mode)
RAZORPAY_KEY_SECRET=
# Razorpay webhook signing secret (live mode)
RAZORPAY_WEBHOOK_SECRET=
# Cloudflare Turnstile: mock | live (anything else means mock)
# Required in production: live or mock (unset fails closed)
TURNSTILE_MODE=mock
# Turnstile public site key (live mode)
TURNSTILE_SITE_KEY=
# Turnstile secret key (live mode)
TURNSTILE_SECRET_KEY=
# Email: mock (writes to the dev-emails inbox in admin) | live (Resend)
# Required in production: live or mock (unset fails closed)
EMAIL_MODE=mock
# Resend API key (live mode)
RESEND_API_KEY=
# From address for live email
EMAIL_FROM=Reyan Collections <orders@reyancollection.in>
# Payload jobs cron runner (expiry and courier polling): set to false to turn it off
JOBS_AUTORUN=true
