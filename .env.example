# Postgres connection string
DATABASE_URI=postgres://user@localhost:5432/reyan_dev
# Payload secret (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public base URL of the site
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Email of the admin user created by the seed script
SEED_ADMIN_EMAIL=admin@reyancollection.in
# Password of the admin user created by the seed script
SEED_ADMIN_PASSWORD=CHANGE_ME
# Media storage backend: local | r2
MEDIA_STORAGE=local
# Cloudflare R2 bucket name (when MEDIA_STORAGE=r2)
R2_BUCKET=
# Cloudflare R2 S3 endpoint URL
R2_ENDPOINT=
# R2 access key id
R2_ACCESS_KEY_ID=
# R2 secret access key
R2_SECRET_ACCESS_KEY=
# Public URL serving R2 media
R2_PUBLIC_URL=
# Node flags used by the Payload CLI
NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"
